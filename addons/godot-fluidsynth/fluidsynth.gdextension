[configuration]
entry_symbol = "fluidsynth_library_init"
compatibility_minimum = "4.7"

[icons]

MIDIListener = "res://addons/godot-fluidsynth/icons/midi-port.svg"
FluidSynthPlayer = "res://addons/godot-fluidsynth/icons/keyboard-music.svg"
SoundFont = "res://addons/godot-fluidsynth/icons/file-music.svg"

[libraries]

linux.debug.x86_64 = "bin/linux.x86_64/libfluidsynth.linux.template_debug.x86_64.so"
linux.release.x86_64 = "bin/linux.x86_64/libfluidsynth.linux.template_release.x86_64.so"

windows.debug.x86_64 = "bin/windows.x86_64/fluidsynth.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "bin/windows.x86_64/fluidsynth.windows.template_release.x86_64.dll"

macos.debug = "bin/macos.universal/libfluidsynth.macos.template_debug.universal.dylib"
macos.release = "bin/macos.universal/libfluidsynth.macos.template_release.universal.dylib"

[dependencies]

linux.debug.x86_64 = {
    "bin/linux.x86_64/libfluidsynth.so.3": ""
}
linux.release.x86_64 = {
    "bin/linux.x86_64/libfluidsynth.so.3": ""
}

windows.debug.x86_64 = {
    "bin/windows.x86_64/libfluidsynth-3.dll": ""
}
windows.release.x86_64 = {
    "bin/windows.x86_64/libfluidsynth-3.dll": ""
}

macos.debug = {
    "bin/macos.universal/libfluidsynth.3.dylib": "Contents/Frameworks"
}
macos.release = {
    "bin/macos.universal/libfluidsynth.3.dylib": "Contents/Frameworks"
}
